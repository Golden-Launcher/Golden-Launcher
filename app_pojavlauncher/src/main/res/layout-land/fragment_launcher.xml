<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/bgMainDrawable"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GOLDEN LAUNCHER"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextPrimary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="By LukeiscoolDEV"
        android:textSize="12sp"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0-source"
        android:textSize="11sp"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="13dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Changes in v1.0:"
        android:textSize="11sp"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Built from source\n• Golden color theme\n• New landscape UI\n• Enhanced design\n• 🇵🇭 Made with pride"
        android:textSize="11sp"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="?attr/colorDivider"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Golden Launcher"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorTextPrimary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Golden Launcher is a Minecraft Java Edition launcher for Android with support for mods, custom controls, and a beautiful golden aesthetic.\n\nJoin our Discord community for support and updates!"
                android:textSize="11sp"
                android:textColor="?attr/colorTextSecondary"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>