<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:27 PM"
            android:textColor="#ffeb3b"
            android:textSize="14sp"
            android:layout_gravity="top|start"
            android:padding="8dp"/>

        <ImageView
            android:id="@+id/add_account_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_add"
            android:tint="#ffeb3b"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Account"
            android:textColor="#ffeb3b"
            android:textSize="18sp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal"
            android:padding="8dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_sharp_settings_24" android:tint="#ffeb3b" android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vo\nLTE" android:textSize="8sp" android:textColor="#ffeb3b" android:gravity="center" android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4G" android:textSize="10sp" android:textColor="#ffeb3b" android:layout_marginEnd="4dp"/>
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_sharp_settings_24" android:tint="#ffeb3b" android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200\nB/s" android:textSize="8sp" android:textColor="#ffeb3b" android:gravity="center" android:layout_marginEnd="4dp"/>
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_menu_custom_controls" android:tint="#ffeb3b" android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="65" android:textColor="#ffeb3b" android:textSize="12sp"/>
        </LinearLayout>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/settings_menu_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_menu_custom_controls"
            android:drawableTint="#ffeb3b"
            android:text="" />

    </androidx.appcompat.widget.Toolbar>

    <View
        android:id="@+id/top_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#222222"
        app:layout_constraintTop_toBottomOf="@id/main_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pane_divider" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pane_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <ScrollView
        android:id="@+id/left_sidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#1a1a1a"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pane_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="#ffeb3b"
                android:alpha="0.7"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/mod_store_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_add"
                android:drawableTint="#ffeb3b"
                android:textColor="#ffeb3b"
                android:text="MOD LIBRARY" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_menu_custom_controls"
                android:drawableTint="#ffeb3b"
                android:textColor="#ffeb3b"
                android:text="CUSTOM CONTROLS" />

            <View 
                android:layout_width="match_parent" 
                android:layout_height="1dp" 
                android:background="#222222" 
                android:layout_marginTop="16dp" 
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INSTANCE TOOLS"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textColor="#ffeb3b"
                android:alpha="0.7"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_folder_managed"
                android:drawableTint="#ffeb3b"
                android:textColor="#ffeb3b"
                android:text="MANAGE MODS\n&amp; TOOLS" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_directory_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_folder"
                android:drawableTint="#ffeb3b"
                android:textColor="#ffeb3b"
                android:text="OPEN GAME" />

            <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <com.kdt.mcgui.LauncherMenuButton android:id="@+id/discord_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />

            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/pane_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#222222"
        app:layout_constraintTop_toBottomOf="@id/main_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/pane_guideline" />

    <FrameLayout
        android:id="@+id/right_pane_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/main_toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toEndOf="@id/pane_divider"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOLDEN LAUNCHER"
                    android:textColor="#ffeb3b"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By LukeiscoolDEV"
                    android:textColor="#ffeb3b"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Changes in v0.2:"
                    android:textColor="#ffeb3b"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Added a New and Improved User Interface for Landscape Mode!\n• Replaced strings\n• Bugfixes\n• Support for Android 16!"
                    android:textColor="#ffeb3b"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#222222"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/pane_divider"
        app:layout_constraintEnd_toEndOf="parent">

        <com.kdt.mcgui.mcVersionSpinner 
            android:id="@+id/mc_version_spinner" 
            android:layout_width="180dp" 
            android:layout_height="match_parent" 
            android:paddingStart="16dp"
            android:background="@android:color/transparent"
            android:textColor="#ffeb3b" />

        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_menu_news" 
            android:drawableTint="@android:color/white"
            android:text=""
            android:padding="12dp"/>

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_add"
            android:tint="@android:color/white"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="16dp"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:backgroundTint="#ff9800"
            android:text="PLAY"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textAllCaps="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
